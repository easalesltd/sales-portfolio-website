# Request an Agent Visit — email confirmation (recommended for production)
# Enable in EmailJS: Account → Security → allow API (non-browser) requests.
#
# Generate a long random string for REQUEST_VISIT_TOKEN_SECRET (32+ chars).
REQUEST_VISIT_TOKEN_SECRET=

# Same public key as the browser EmailJS init; can use NEXT_PUBLIC_EMAILJS_PUBLIC_KEY instead.
# EMAILJS_PUBLIC_KEY=

# Private key from EmailJS (server only — never commit real values)
EMAILJS_PRIVATE_KEY=

# New EmailJS template: email goes TO the visitor. Template must use {{to_email}} as the
# recipient, and body should include {{confirm_url}} and optionally {{from_name}}.
EMAILJS_TEMPLATE_VERIFY=

# Optional overrides (defaults match existing service + visit template)
# EMAILJS_SERVICE_ID=service_fvfxlgh
# EMAILJS_TEMPLATE_VISIT=template_35gndyb

# Links in the verification email should use your real domain:
NEXT_PUBLIC_SITE_URL=https://www.easalesltd.co.uk
