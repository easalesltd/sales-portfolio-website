# Sales Agent Dash — global leaderboard (optional)
# Create a Redis database at https://console.upstash.com (free tier is fine),
# or add Vercel → Storage → Redis and link it to this project — then copy the
# REST URL and token into Vercel → Project → Settings → Environment Variables
# and redeploy.
#
# Either pair works (Upstash names preferred):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy Vercel KV names (still wired if your project has not been renamed):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
