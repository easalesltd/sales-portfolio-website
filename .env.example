# =============================================================================
# SIMPLEST “confirm email” setup (recommended) — Resend only, see CONFIRM_EMAIL_SIMPLE.md
# =============================================================================
REQUEST_VISIT_TOKEN_SECRET=
RESEND_API_KEY=
RESEND_FROM=
VISIT_REQUEST_NOTIFY_EMAIL=
NEXT_PUBLIC_SITE_URL=https://www.easalesltd.co.uk
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Bing Webmaster Tools verification value (meta tag)
NEXT_PUBLIC_BING_VERIFICATION_CODE=
# IndexNow — optional; script defaults to the committed public key file
# public/c509aba8456d5c87cdfe9b6e74c11f7d.txt
INDEXNOW_KEY=c509aba8456d5c87cdfe9b6e74c11f7d
INDEXNOW_KEY_LOCATION=https://www.easalesltd.co.uk/c509aba8456d5c87cdfe9b6e74c11f7d.txt

# =============================================================================
# Optional: EmailJS for notifications instead of Resend (needs private key).
# Omit VISIT_REQUEST_NOTIFY_EMAIL path above if you use this + verification channel below.
# =============================================================================
# EMAILJS_PRIVATE_KEY=
# EMAILJS_TEMPLATE_VERIFY=

# Browser EmailJS (your existing public key — can be shared with server)
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# =============================================================================
# Optional: Sales Agent Dash global leaderboard (Upstash Redis REST API)
# Create a free database at https://upstash.com OR add Vercel KV / Redis storage — then either:
#   UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
#   OR (Vercel Storage) KV_REST_API_URL + KV_REST_API_TOKEN
# Without these, the game still runs; the board stays empty and submit returns 503.
# =============================================================================
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# Optional: delete a bad leaderboard name (moderation). Use a long random string; never commit it.
# curl -X DELETE "$ORIGIN/api/game-leaderboard" \
#   -H "Authorization: Bearer $GAME_LEADERBOARD_ADMIN_SECRET" \
#   -H "Content-Type: application/json" \
#   -d '{"level":"road","rank":3}'
# Same `rank` as the list shown in the game (1 = top). Or use "memberId": "<uuid>" from Upstash.
# GAME_LEADERBOARD_ADMIN_SECRET=
