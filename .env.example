# Request an Agent Visit — email confirmation (reduces fake submissions)
# Enable in EmailJS: Account → Security → allow API (non-browser) requests.
#
# Generate a long random string for REQUEST_VISIT_TOKEN_SECRET (32+ chars).
REQUEST_VISIT_TOKEN_SECRET=

# Same public key as the browser EmailJS init; can use NEXT_PUBLIC_EMAILJS_PUBLIC_KEY instead.
# EMAILJS_PUBLIC_KEY=

# Private key from EmailJS (server only — used after the visitor confirms, to email you)
EMAILJS_PRIVATE_KEY=

# Visitor “click to confirm” email — pick ONE option:
#
# Option A (no extra EmailJS template): Resend — https://resend.com — free tier
RESEND_API_KEY=
# From address Resend accepts (verify your domain in Resend, or use onboarding sender for tests)
RESEND_FROM="East Anglian Sales <onboarding@resend.dev>"

# Option B: Extra EmailJS template to {{to_email}} with {{confirm_url}} (if you have template quota)
# EMAILJS_TEMPLATE_VERIFY=

# Optional overrides (defaults match existing service + visit template)
# EMAILJS_SERVICE_ID=service_fvfxlgh
# EMAILJS_TEMPLATE_VISIT=template_35gndyb

# Links in the confirmation email should use your real domain:
NEXT_PUBLIC_SITE_URL=https://www.easalesltd.co.uk
